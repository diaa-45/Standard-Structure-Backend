using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Application.Core.DTOs;
using Application.Core.Entities;
using Application.Core.Interfaces;
using Application.Infrastructure.Services;
using System;

namespace Application.Api.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    public class AuthController : ControllerBase
    {
        private readonly IUserRepository _users;
        private readonly ITokenService _tokens;

        public AuthController(IUserRepository users, ITokenService tokens)
        {
            _users = users;
            _tokens = tokens;
        }

        [HttpPost("register")]
        public async Task<IActionResult> Register([FromBody] RegisterRequest req)
        {
            var exists = await _users.GetByUserNameAsync(req.UserName) ?? await _users.GetByEmailAsync(req.Email);
            if (exists != null) return Conflict("User with same username or email already exists.");

            var user = new User
            {
                UserName = req.UserName,
                Email = req.Email,
                PasswordHash = Application.Infrastructure.Services.TokenService.HashPassword(req.Password),
                LastLoginAt = DateTime.UtcNow,
                LastLoginIp = GetClientIp()
            };

            await _users.AddAsync(user);
            await _users.SaveChangesAsync();

            var auth = await _tokens.CreateTokensAsync(user);
            return Ok(auth);
        }

        [HttpPost("login")]
        public async Task<IActionResult> Login([FromBody] LoginRequest req)
        {
            var user = await _users.GetByUserNameOrEmailAsync(req.UserNameOrEmail);
            if (user == null) return Unauthorized("Invalid credentials.");

            if (!Application.Infrastructure.Services.TokenService.VerifyPassword(req.Password, user.PasswordHash))
                return Unauthorized("Invalid credentials.");

            // update last login info
            user.LastLoginAt = DateTime.UtcNow;
            user.LastLoginIp = GetClientIp();
            await _users.UpdateAsync(user);
            await _users.SaveChangesAsync();

            var auth = await _tokens.CreateTokensAsync(user);
            return Ok(auth);
        }

        [HttpPost("refresh")]
        public async Task<IActionResult> Refresh([FromBody] RefreshRequest req)
        {
            var result = await _tokens.RefreshAsync(req.RefreshToken);
            if (result == null) return Unauthorized("Invalid refresh token.");
            return Ok(result);
        }

        [Authorize]
        [HttpPost("revoke")]
        public async Task<IActionResult> Revoke([FromBody] RefreshRequest req)
        {
            await _tokens.RevokeRefreshTokenAsync(req.RefreshToken);
            return NoContent();
        }

        private string GetClientIp()
        {
            try
            {
                // Prefer X-Forwarded-For (in case app is behind a proxy/load balancer)
                if (Request.Headers.TryGetValue("X-Forwarded-For", out var values))
                {
                    var first = values.ToString().Split(',')[0]?.Trim();
                    if (!string.IsNullOrWhiteSpace(first)) return first;
                }

                // Fallback to connection remote IP
                return HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? string.Empty;
            }
            catch
            {
                return string.Empty;
            }
        }
    }
}
